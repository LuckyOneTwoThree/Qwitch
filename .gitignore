# Dependencies
node_modules/

# Build outputs
dist/
dist-ssr/
*.local

# Rust / Tauri
src-tauri/target/
src-tauri/gen/
# 由 build.rs 的 AppManifest::commands 自动生成（文件头标注 DO NOT EDIT），
# 每次构建都会重建，因此不纳入版本控制。
src-tauri/permissions/autogenerated/

# OS & Editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# 本地 Agent 工作区数据（对话记忆、临时产物），不随仓库分发
.workbuddy/

# 探针输出
probe-out/

# 临时副本 / 快照目录（防止同名副本被 vitest 或 git 误纳入）
qwitch/
*.snapshot/
*.bak/
