{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Qwitch main and tray window capabilities. Application commands are explicitly allow-listed so that a compromised renderer cannot reach IPC surface it does not need.",
  "windows": ["main", "tray"],
  "permissions": [
    "core:default",

    "allow-show-main-window",
    "allow-quit-app",
    "allow-get-app-settings",
    "allow-save-app-settings",
    "allow-list-adapters",
    "allow-list-external-adapters",
    "allow-request-plugin-trust",
    "allow-detect-client-status",
    "allow-reconcile-active-accounts",
    "allow-list-accounts",
    "allow-get-account-summary",
    "allow-import-local-account",
    "allow-preview-local-account",
    "allow-launch-tool-profile",
    "allow-inspect-profile-dir",
    "allow-pick-folder",
    "allow-pick-file",
    "allow-add-account-by-token",
    "allow-start-webview-oauth",
    "allow-refresh-account-quota",
    "allow-refresh-quota-batch",
    "allow-switch-desktop-account",
    "allow-delete-account",
    "allow-update-account-status",
    "allow-rename-account",
    "allow-claim-daily-batch",
    "allow-get-action-logs",
    "allow-get-action-log-stats",
    "allow-archive-action-logs",
    "allow-unarchive-action-logs",
    "allow-delete-action-logs",
    "allow-export-action-logs",
    "allow-check-app-update",
    "allow-download-and-install-update",
    "allow-open-update-url"
  ]
}
