{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qwitch",
  "version": "0.1.0",
  "identifier": "dev.qwitch.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Qwitch",
        "width": 1080,
        "height": 740,
        "minWidth": 860,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "tray",
        "title": "Qwitch Tray",
        "url": "index.html?view=tray",
        "width": 340,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
